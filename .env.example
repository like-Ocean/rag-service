ENV=development

APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=True
APP_LOG_LEVEL=debug
DEBUG=True

SERVICE_TOKEN=change-me
ADMIN_SERVICE_TOKEN=My-token

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=moodle_docs

EMBEDDING_MODEL=BAAI/bge-m3
# pymupdf (быстро, только текст) | pix2text (бесплатный аналог Mathpix: формулы+таблицы, медленнее)
PDF_PARSER=pymupdf
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

TOP_K=5
SEARCH_MODE=hybrid
RERANKER_ENABLED=False
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=20
CHUNK_STRATEGY=semantic
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CONTEXT_PER_CHUNK=1200
FAITHFULNESS_CHECK_ENABLED=False
RUNTIME_CONFIG_PATH=data/runtime_config.json
